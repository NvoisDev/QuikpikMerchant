# ===================================
# QUIKPIK ENVIRONMENT VARIABLES
# ===================================
# This is a template file. Copy this to .env and fill in your actual values.
# IMPORTANT: Never commit .env with real credentials to version control!
# For Replit: Use the Secrets tool for sensitive values (API keys, tokens)

# ===================================
# DATABASE
# ===================================
# PostgreSQL connection string (automatically provided by Replit database)
DATABASE_URL=postgresql://user:password@host:port/database

# ===================================
# APPLICATION ENVIRONMENT
# ===================================
NODE_ENV=development
FRONTEND_URL=http://localhost:5000
CLIENT_URL=http://localhost:5000

# ===================================
# REPLIT CONFIGURATION
# ===================================
# These are automatically set by Replit
REPL_ID=
REPLIT_DEV_DOMAIN=
REPLIT_DOMAINS=
ISSUER_URL=https://replit.com/oidc

# ===================================
# SESSION & SECURITY
# ===================================
SESSION_SECRET=your-secure-random-session-secret-here

# ===================================
# STRIPE PAYMENT PROCESSING
# ===================================
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# ===================================
# OPENAI (AI Features)
# ===================================
OPENAI_API_KEY=sk-your-openai-api-key

# ===================================
# SENDGRID (Email Service)
# ===================================
SENDGRID_API_KEY=SG.your_sendgrid_api_key
SENDGRID_FROM_EMAIL=noreply@yourdomain.com

# ===================================
# TWILIO (SMS & WhatsApp)
# ===================================
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# ===================================
# GOOGLE SERVICES
# ===================================
# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_OAUTH_REDIRECT_URI=https://yourdomain.com/api/auth/google/callback

# Google Places API
GOOGLE_PLACES_API_KEY=your-google-places-api-key

# ===================================
# REPLIT OBJECT STORAGE
# ===================================
PUBLIC_OBJECT_SEARCH_PATHS=
PRIVATE_OBJECT_DIR=

# ===================================
# PARCEL2GO (Shipping Integration)
# ===================================
PARCEL2GO_CLIENT_ID=your_parcel2go_client_id
PARCEL2GO_CLIENT_SECRET=your_parcel2go_client_secret
PARCEL2GO_ENVIRONMENT=sandbox
